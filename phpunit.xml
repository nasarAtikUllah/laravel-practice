<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SHOP_CURRENCY" value="BDT"/>
        <env name="SHOP_CURRENCY_SYMBOL" value="৳"/>
        <env name="FREE_DELIVERY_MIN_ORDER" value="5000"/>
        <env name="DELIVERY_FEE" value="0"/>
        <env name="CART_MAX_QUANTITY" value="20"/>
        <env name="CART_MAX_LINES" value="30"/>

        <env name="PAYMENT_GATEWAY" value="sslcommerz"/>
        <env name="PAYMENT_MAX_ATTEMPTS" value="3"/>
        <env name="PAYMENT_MIN_AMOUNT" value="10"/>
        <env name="PAYMENT_MAX_AMOUNT" value="500000"/>
        <env name="SSLCOMMERZ_STORE_ID" value="teststore"/>
        <env name="SSLCOMMERZ_STORE_PASSWORD" value="teststore@ssl"/>
        <env name="SSLCOMMERZ_SANDBOX" value="true"/>
        <env name="SSLCOMMERZ_CALLBACK_BASE" value="https://shop.test"/>
        <env name="SSLCOMMERZ_TIMEOUT" value="15"/>

        <env name="PAYMENT_RETURN_URL" value="https://shop.test/payment/result"/>
        <env name="PAYMENT_CALLBACK_LIMIT" value="120"/>
        <env name="PAYMENT_CALLBACK_PER_REFERENCE" value="10"/>
        <env name="SSLCOMMERZ_VERIFY_SIGNATURE" value="true"/>
    </php>
</phpunit>
